{
  "name": "orbit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An autonomous AI browser agent. Bring your own key.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run compile && npm test",
    "preview": "vite --config preview/vite.config.ts",
    "shots": "node scripts/preview-shots.mjs",
    "smoke": "node scripts/extension-smoke.mjs",
    "e2e": "ORBIT_E2E=1 wxt build && node scripts/e2e-agent.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wxt": "^0.20.0"
  }
}
